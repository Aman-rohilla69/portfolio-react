.mywork-title h1 {
  padding: 0 30px;
  font-size: 60px;
  font-weight: 600;
  background: linear-gradient(264deg, #df8908 10%, #b415ff 100%);
  border-radius: 20px;
  transition: 0.5s;
}
.mywork-title h1:hover {
  border: 2px solid #fff;
  transform: scale(0.89);
  cursor: pointer;
  filter: drop-shadow(1px 1px 30px #fff );
}
.work_img {
  width: 105%;
  object-fit: contain;
  aspect-ratio: 3/2;
}
.mywork {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 80px;
  margin: 80px 170px;
}
.mywork-title {
  position: relative;
}
.mywork-container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 40px;
}
.mywork-container img {
  box-sizing: border-box;
  width: 419px;
  height: 280px;
  transition: 0.3s;
  cursor: pointer;
}
.mywork-container img:hover {
  transform: scale(1.1);
  border: 4px solid #fff;
  object-fit: cover;
  border-radius: 10px;
  transition: 0.3s;
  filter: drop-shadow(1px 1px 30px #fff );

}
.mywork-showmore {
  display: flex;
  gap: 15px;
  text-align: center;
  justify-content: center;
  border-radius: 50px;
  border: 2px solid white;
  padding: 30px 80px;
  font-size: 22px;
  font-weight: 500;
  margin-bottom: 80px;
  transition: 0.6s;
  cursor: pointer;
}
.mywork-showmore p {
  margin-top: 8px;
  filter: drop-shadow(1px 1px 20px #fff );
}
.mywork-showmore:hover {
  gap: 30px;
  transition: 0.6s;
  border: 2px solid #b415ff;
  font-weight: 700;
  
  mix-blend-mode: screen;
}
@media(max-width:768px){
  .mywork{
    gap: 50px;
    margin: 50px 70px;
    align-items: start;
  }
  .mywork-title h1{
    padding: 0;
    font-size:50px;
    font-weight: 600;
  }
  .mywork-title img{
    width: 130px;
    margin-right: -120px;
  }
  .mywork-container{
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
  .mywork-container img{
    width: 100%;
    height: 100%;
    mix-blend-mode: screen;
  }
  .mywork-showmore{
    padding: 20px 40px;
    font-size: 18px;
    margin: 50px auto;
    cursor: pointer;
  }

}